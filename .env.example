# Shared secret for the phone page and the API. Use a long random string.
KEO_TOKEN=change-me

# Where Kéo's files live on this machine.
KEO_MUSIC_PATH=./music
KEO_DATA_PATH=./data
KEO_CONFIG_PATH=./keo.toml
KEO_SECRETS_PATH=./secrets

# File name inside KEO_SECRETS_PATH: browser.json, or the OAuth file from `ytmusicapi oauth`.
KEO_YTM_AUTH_FILE=browser.json
# Only for an OAuth file.
KEO_YTM_CLIENT_ID=
KEO_YTM_CLIENT_SECRET=

# Owner of the music files. Run `id -u` and `id -g` on the host.
PUID=1000
PGID=1000
KEO_PORT=8000
