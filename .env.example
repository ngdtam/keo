# Optional initial password / token. Leave unset on fresh installs to create your
# username and password in the browser at /setup.
# KEO_TOKEN=change-me

# Web sign-in username (defaults to admin) and optional fixed API key.
# KEO_USERNAME=admin
# KEO_API_KEY=
# Set to 1 and restart to reset credentials (re-opens /setup when KEO_TOKEN is unset,
# or resets back to KEO_USERNAME and KEO_TOKEN if set).
# KEO_RESET_PASSWORD=1

# Where Kéo's files live on this machine.
KEO_MUSIC_PATH=./music
KEO_DATA_PATH=./data
KEO_CONFIG_PATH=./keo.toml
KEO_SECRETS_PATH=./secrets

# Optional YouTube Music auth file inside KEO_SECRETS_PATH (browser.json or OAuth JSON).
# On fresh installs you can also paste browser headers or upload browser.json in /setup or Settings.
# KEO_YTM_AUTH_FILE=browser.json
# Only for an OAuth file.
KEO_YTM_CLIENT_ID=
KEO_YTM_CLIENT_SECRET=

# Owner of the music files. Run `id -u` and `id -g` on the host.
PUID=1000
PGID=1000
KEO_PORT=8000

# Zone for the 22:00 history check and the times on the Jobs page.
TZ=Asia/Ho_Chi_Minh
